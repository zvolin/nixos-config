-# .gitignore keeps the workspace out of `git status` and out of accidental
-# commits without modifying any tracked file.
+# an implementer subagent from writing its report file. A single self-ignoring
+# .gitignore at the .superpowers/sdd/ level (a lone "*") recursively keeps every
+# slug directory, and itself, out of `git status` and out of accidental commits
+# without modifying any tracked file.
 #
-# Single source of truth for the workspace location, so task-brief and
-# review-package cannot drift to different directories.
+# Single source of truth for the workspace location and the slug rule, so
+# task-brief and review-package cannot drift to different directories.
 #
-# Usage: sdd-workspace
+# Usage: sdd-workspace PLAN_FILE
 set -euo pipefail

+if [ $# -ne 1 ]; then
+  echo "usage: sdd-workspace PLAN_FILE" >&2
+  exit 2
+fi
+
+plan=$1
+slug=$(basename "$plan")
+slug=${slug%.md}
+
 root=$(git rev-parse --show-toplevel)
-dir="$root/.superpowers/sdd"
+base="$root/.superpowers/sdd"
+mkdir -p "$base"
+printf '*\n' > "$base/.gitignore"
+dir="$base/$slug"
 mkdir -p "$dir"
-printf '*\n' > "$dir/.gitignore"
 cd "$dir" && pwd
